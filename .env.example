# Copy this file to .env and fill it in. Never commit .env.
# Leave the key empty to stay in practice mode (the local test server).

# Your Resend API key. Use a "Sending access" key.
RESEND_API_KEY=

# Live API: https://api.resend.com   Practice: http://localhost:4000
RESEND_BASE_URL=https://api.resend.com

# Without a verified domain, Resend only allows onboarding@resend.dev.
SENDER_EMAIL_ADDRESS=onboarding@resend.dev
